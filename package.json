{
  "name": "staticforge-jamstack",
  "version": "1.0.0",
  "private": true,
  "description": "Projet pédagogique Full-Stack : générateur de sites statiques Jamstack",
  "main": "backend/src/server.js",
  "scripts": {
    "dev": "concurrently \"nodemon backend/src/server.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "nodemon backend/src/server.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build && npm run build:site",
    "build:site": "node backend/src/cli.js",
    "start": "node backend/src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "preview": "vite preview --host 0.0.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vite": "^6.0.7"
  }
}
